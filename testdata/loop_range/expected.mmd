flowchart TD
s((Start))
Summarize[Summarize]
subgraph L0 ["each item in items"]
  l0{{"↻"}}:::loop
  ProcessItem[Process Item]
end
e((End))
s --> l0
l0 --> ProcessItem
ProcessItem -.-> l0
l0 -- done --> Summarize
