flowchart TD
s((Start))
SendReceipt[Send Receipt]
subgraph L0 ["while attempt <= 3"]
  l0{{"↻"}}:::loop
  ChargeCard[Charge Card]
  d0{"err == nil"}
end
e((End))
s --> l0
l0 --> ChargeCard
ChargeCard --> d0
d0 -. no .-> l0
l0 -- done --> SendReceipt
d0 -- yes --> SendReceipt
SendReceipt --> e
classDef loop fill:#fde7c8,stroke:#c77700,stroke-width:2px,color:#333
linkStyle 3 stroke:#c77700,stroke-width:2px
linkStyle 4 stroke:#2e7d32,stroke-width:3px
linkStyle 5 stroke:#333,stroke-width:3px
style L0 fill:#fffaf2,stroke:#c77700,stroke-dasharray:4,color:#333
