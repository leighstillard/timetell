%% OrderWorkflow
flowchart LR
s((Start))
ManagerApproval[Manager Approval]
PaymentWorkflow[[Payment Workflow]]
SendConfirmation[Send Confirmation]
ValidateOrder[Validate Order]
d0{High Value}
e((End))
s --> ValidateOrder
